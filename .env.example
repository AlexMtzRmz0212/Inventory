# Copy to .env.local and fill in. Never commit .env.local.

# Notion integration token (https://www.notion.so/profile/integrations).
# Share the "Inventory" page with the integration. Leave empty in dev to use sample data.
NOTION_TOKEN=

# Notion data source IDs (open each database in Notion, copy its data source ID)
NOTION_ITEMS_DS=
NOTION_BOXES_DS=
NOTION_LOCATIONS_DS=
# Optional: the packing list. Leave empty to hide the Luggage button.
NOTION_LUGGAGE_DS=

# Private view login
PRIVATE_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 32`
SESSION_SECRET=
